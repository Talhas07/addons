<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Technical Report Template -->
        <template id="report_technical">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">

                        <div class="page" style="font-family: Arial, sans-serif;">
                            <div class="oe_structure"/>

                            <!-- Title -->
                            <div class="row">
                                <div class="col-12">
                                    <h3 style="margin-bottom: 20px;">
                                        <strong>TECHNICAL REPORT</strong>
                                        <t t-if="o.report_title">
                                            <strong> &#8211; <t t-esc="o.report_title"/></strong>
                                        </t>
                                    </h3>
                                </div>
                            </div>

                            <!-- Reference Details -->
                            <div class="row">
                                <div class="col-12">
                                    <table style="width: 100%; margin-bottom: 15px;">
                                        <tr t-if="o.partner_id">
                                            <td style="width: 150px; padding: 3px 0;"><strong>Customer:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.partner_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;"><strong>Job Number:</strong></td>
                                            <td style="padding: 3px 0;">
                                                <t t-if="o.customer_reference">
                                                    <span t-field="o.customer_reference"/>
                                                </t>
                                                <t t-elif="o.manual_job_card">
                                                    <span t-field="o.manual_job_card"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-field="o.name"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr t-if="o.appliance_model">
                                            <td style="padding: 3px 0;"><strong>Model:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.appliance_model"/></td>
                                        </tr>
                                        <tr t-if="o.appliance_serial_number">
                                            <td style="padding: 3px 0;"><strong>Serial Number:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.appliance_serial_number"/></td>
                                        </tr>
                                        <tr t-if="o.reported_fault">
                                            <td style="padding: 3px 0;"><strong>Reported Fault:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.reported_fault"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- DIAGNOSIS / FINDINGS -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                        <strong>Diagnosis / Findings</strong>
                                    </h5>
                                    <div style="margin-bottom: 15px;">
                                        <t t-if="o.diagnosis_notes">
                                            <t t-out="o.diagnosis_notes"/>
                                        </t>
                                        <t t-else="">
                                            <p style="color: #999;">No diagnosis notes provided.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- CAUSE OF FAULT -->
                            <t t-if="o.root_cause">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                            <strong>Cause of Fault</strong>
                                        </h5>
                                        <div style="margin-bottom: 15px;">
                                            <p><span t-field="o.root_cause"/></p>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- ADDITIONAL OBSERVATIONS -->
                            <t t-if="o.additional_observations">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                            <strong>Additional Observations</strong>
                                        </h5>
                                        <div style="margin-bottom: 15px;">
                                            <t t-out="o.additional_observations"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- RECOMMENDATION -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                        <strong>Recommendation</strong>
                                    </h5>
                                    <div style="margin-bottom: 15px;">
                                        <t t-if="o.repair_recommendations">
                                            <t t-out="o.repair_recommendations"/>
                                        </t>
                                        <t t-else="">
                                            <p style="color: #999;">No recommendations provided.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- TECHNICIAN REMARKS -->
                            <t t-if="o.technician_remarks">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="margin-bottom: 8px;">
                                            <strong>Technician Remarks:</strong>
                                        </h5>
                                        <div style="margin-bottom: 20px;">
                                            <t t-out="o.technician_remarks"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- PREPARED BY / SIGNATURE -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <p><strong>Prepared By:</strong></p>
                                    <table style="width: 50%;">
                                        <tr t-if="o.prepared_by">
                                            <td style="padding: 3px 0;"><strong>Manager:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.prepared_by.name"/></td>
                                        </tr>
                                        <tr t-if="o.diagnosis_date">
                                            <td style="padding: 3px 0;"><strong>Date:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.diagnosis_date" t-options='{"format": "dd/MM/yyyy"}'/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;"><strong>Signature:</strong></td>
                                            <td style="padding: 3px 0;">_______________________</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
