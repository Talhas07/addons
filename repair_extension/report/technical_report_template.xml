<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Technical Report Template (Diagnostic + Technical pages) -->
        <template id="report_technical">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">

                        <div class="page">
                            <div class="oe_structure"/>

                            <!-- ===================== PAGE 1: DIAGNOSTIC REPORT ===================== -->

                            <!-- Header -->
                            <div class="row">
                                <div class="col-12 text-center">
                                    <h2 style="border-bottom: 2px solid #333; padding-bottom: 10px;">
                                        <strong>DIAGNOSTIC REPORT</strong>
                                    </h2>
                                </div>
                            </div>

                            <!-- Reference Numbers -->
                            <div class="row mt-4">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Repair Order #:</strong></td>
                                            <td><span t-field="o.name"/></td>
                                        </tr>
                                        <tr t-if="o.manual_job_card">
                                            <td><strong>Job Card #:</strong></td>
                                            <td><span t-field="o.manual_job_card"/></td>
                                        </tr>
                                        <tr t-if="o.customer_reference">
                                            <td><strong>Customer Reference:</strong></td>
                                            <td><span t-field="o.customer_reference"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Report Date:</strong></td>
                                            <td><span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr t-if="o.diagnosis_date">
                                            <td><strong>Diagnosis Date:</strong></td>
                                            <td><span t-field="o.diagnosis_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                        </tr>
                                        <tr t-if="o.diagnosed_by">
                                            <td><strong>Diagnosed By:</strong></td>
                                            <td><span t-field="o.diagnosed_by.name"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td><span t-field="o.state"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Customer Information -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4 style="background-color: #f0f0f0; padding: 8px;">Customer Information</h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr t-if="o.partner_id">
                                            <td><strong>Customer Name:</strong></td>
                                            <td><span t-field="o.partner_id.name"/></td>
                                        </tr>
                                        <tr t-if="o.partner_id and o.partner_id.phone">
                                            <td><strong>Phone:</strong></td>
                                            <td><span t-field="o.partner_id.phone"/></td>
                                        </tr>
                                        <tr t-if="o.partner_id and o.partner_id.email">
                                            <td><strong>Email:</strong></td>
                                            <td><span t-field="o.partner_id.email"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <div t-if="o.partner_id" t-field="o.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                </div>
                            </div>

                            <!-- Appliance Details -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4 style="background-color: #f0f0f0; padding: 8px;">Appliance Details</h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr t-if="o.product_id">
                                            <td><strong>Product:</strong></td>
                                            <td><span t-field="o.product_id.display_name"/></td>
                                        </tr>
                                        <tr t-if="o.appliance_brand">
                                            <td><strong>Brand:</strong></td>
                                            <td><span t-field="o.appliance_brand"/></td>
                                        </tr>
                                        <tr t-if="o.appliance_model">
                                            <td><strong>Model:</strong></td>
                                            <td><span t-field="o.appliance_model"/></td>
                                        </tr>
                                        <tr t-if="o.appliance_serial_number">
                                            <td><strong>Serial Number:</strong></td>
                                            <td><span t-field="o.appliance_serial_number"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr t-if="o.supplier_id">
                                            <td><strong>Supplier:</strong></td>
                                            <td><span t-field="o.supplier_id.name"/></td>
                                        </tr>
                                        <tr t-if="o.purchase_date">
                                            <td><strong>Purchase Date:</strong></td>
                                            <td><span t-field="o.purchase_date"/></td>
                                        </tr>
                                        <tr t-if="o.condition_on_receipt">
                                            <td><strong>Condition on Receipt:</strong></td>
                                            <td><span t-field="o.condition_on_receipt"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Warranty Information -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4 style="background-color: #f0f0f0; padding: 8px;">Warranty Information</h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td style="width: 200px;"><strong>Warranty Status:</strong></td>
                                            <td>
                                                <t t-if="o.warranty_status == 'valid'">
                                                    <span style="color: green; font-weight: bold;">VALID WARRANTY</span>
                                                </t>
                                                <t t-elif="o.warranty_status == 'expired'">
                                                    <span style="color: red; font-weight: bold;">WARRANTY EXPIRED</span>
                                                </t>
                                                <t t-elif="o.warranty_status == 'void'">
                                                    <span style="color: orange; font-weight: bold;">WARRANTY VOID</span>
                                                </t>
                                                <t t-elif="o.warranty_status == 'not_applicable'">
                                                    <span>Not Applicable</span>
                                                </t>
                                                <t t-else="">
                                                    <span>Unknown</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Accessories Received -->
                            <t t-if="o.accessories_received">
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h4 style="background-color: #f0f0f0; padding: 8px;">Accessories Received</h4>
                                        <div class="p-2" style="border: 1px solid #ddd; min-height: 50px;">
                                            <span t-field="o.accessories_received"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Fault Description -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4 style="background-color: #f0f0f0; padding: 8px;">Fault Description</h4>
                                    <div class="p-2" style="border: 1px solid #ddd; min-height: 80px;">
                                        <t t-if="o.fault_description">
                                            <t t-out="o.fault_description"/>
                                        </t>
                                        <t t-else="">
                                            <span style="color: #999;">No fault description provided.</span>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Diagnosis Notes -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4 style="background-color: #f0f0f0; padding: 8px;">Diagnosis Notes</h4>
                                    <div class="p-2" style="border: 1px solid #ddd; min-height: 100px;">
                                        <t t-if="o.diagnosis_notes">
                                            <t t-out="o.diagnosis_notes"/>
                                        </t>
                                        <t t-else="">
                                            <span style="color: #999;">No diagnosis notes provided.</span>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- ===================== PAGE BREAK ===================== -->
                            <div style="page-break-before: always;"/>

                            <!-- ===================== PAGE 2: TECHNICAL REPORT ===================== -->

                            <!-- Title -->
                            <div class="row">
                                <div class="col-12">
                                    <h3 style="margin-bottom: 20px;">
                                        <strong>TECHNICAL REPORT</strong>
                                        <t t-if="o.report_title">
                                            <strong> &#8211; <t t-esc="o.report_title"/></strong>
                                        </t>
                                    </h3>
                                </div>
                            </div>

                            <!-- Reference Details -->
                            <div class="row">
                                <div class="col-12">
                                    <table style="width: 100%; margin-bottom: 15px;">
                                        <tr t-if="o.partner_id">
                                            <td style="width: 150px; padding: 3px 0;"><strong>Customer:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.partner_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;"><strong>Job Number:</strong></td>
                                            <td style="padding: 3px 0;">
                                                <t t-if="o.customer_reference">
                                                    <span t-field="o.customer_reference"/>
                                                </t>
                                                <t t-elif="o.manual_job_card">
                                                    <span t-field="o.manual_job_card"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-field="o.name"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr t-if="o.appliance_model">
                                            <td style="padding: 3px 0;"><strong>Model:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.appliance_model"/></td>
                                        </tr>
                                        <tr t-if="o.appliance_serial_number">
                                            <td style="padding: 3px 0;"><strong>Serial Number:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.appliance_serial_number"/></td>
                                        </tr>
                                        <tr t-if="o.reported_fault">
                                            <td style="padding: 3px 0;"><strong>Reported Fault:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.reported_fault"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- DIAGNOSIS / FINDINGS -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                        <strong>Diagnosis / Findings</strong>
                                    </h5>
                                    <div style="margin-bottom: 15px;">
                                        <t t-if="o.diagnosis_notes">
                                            <t t-out="o.diagnosis_notes"/>
                                        </t>
                                        <t t-else="">
                                            <p style="color: #999;">No diagnosis notes provided.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- CAUSE OF FAULT -->
                            <t t-if="o.root_cause">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                            <strong>Cause of Fault</strong>
                                        </h5>
                                        <div style="margin-bottom: 15px;">
                                            <p><span t-field="o.root_cause"/></p>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- ADDITIONAL OBSERVATIONS -->
                            <t t-if="o.additional_observations">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                            <strong>Additional Observations</strong>
                                        </h5>
                                        <div style="margin-bottom: 15px;">
                                            <t t-out="o.additional_observations"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- RECOMMENDATION -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <h5 style="text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 3px; margin-bottom: 8px;">
                                        <strong>Recommendation</strong>
                                    </h5>
                                    <div style="margin-bottom: 15px;">
                                        <t t-if="o.repair_recommendations">
                                            <t t-out="o.repair_recommendations"/>
                                        </t>
                                        <t t-else="">
                                            <p style="color: #999;">No recommendations provided.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- TECHNICIAN REMARKS -->
                            <t t-if="o.technician_remarks">
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <h5 style="margin-bottom: 8px;">
                                            <strong>Technician Remarks:</strong>
                                        </h5>
                                        <div style="margin-bottom: 20px;">
                                            <t t-out="o.technician_remarks"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- PREPARED BY / SIGNATURE -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <p><strong>Prepared By:</strong></p>
                                    <table style="width: 50%;">
                                        <tr t-if="o.prepared_by">
                                            <td style="padding: 3px 0;"><strong>Manager:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.prepared_by.name"/></td>
                                        </tr>
                                        <tr t-if="o.diagnosis_date">
                                            <td style="padding: 3px 0;"><strong>Date:</strong></td>
                                            <td style="padding: 3px 0;"><span t-field="o.diagnosis_date" t-options='{"format": "dd/MM/yyyy"}'/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;"><strong>Signature:</strong></td>
                                            <td style="padding: 3px 0;">_______________________</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
